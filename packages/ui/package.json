{
	"name": "@hubble.md/ui",
	"version": "0.0.1",
	"private": true,
	"description": "Shared React editor UI for Hubble.md",
	"license": "MIT",
	"author": "Ben Holmes <hey@bholmes.dev>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bholmesdev/hubble.md.git",
		"directory": "packages/ui"
	},
	"homepage": "https://hubble.md",
	"bugs": "https://github.com/bholmesdev/hubble.md/issues",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./tailwind.css": "./dist/tailwind.css",
		"./theme.css": "./dist/theme.css",
		"./fonts.css": "./dist/fonts.css"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"dev": "vite build --watch"
	},
	"dependencies": {
		"@mdly/workspace-kit": "workspace:*"
	},
	"peerDependencies": {
		"react": "^19.1.0",
		"react-dom": "^19.1.0"
	},
	"devDependencies": {
		"@types/react": "^19.1.8",
		"typescript": "~5.8.3",
		"vite": "^7.0.4"
	}
}
