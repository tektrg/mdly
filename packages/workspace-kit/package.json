{
	"name": "@mdly/workspace-kit",
	"version": "0.0.1",
	"description": "Shared Markdown editor engine, editor surface, and file-navigation UI for mdly-based products",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./engine": {
			"types": "./dist/engine/index.d.ts",
			"default": "./dist/engine.js"
		},
		"./style.css": "./dist/index.css"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"dev": "vite build --watch",
		"test": "vitest run"
	},
	"dependencies": {
		"@base-ui/react": "^1.3.0",
		"@dnd-kit/core": "^6.3.1",
		"@floating-ui/dom": "^1.7.5",
		"@tiptap/core": "^3.4.3",
		"@tiptap/extension-code-block-lowlight": "3.20.0",
		"@tiptap/extension-list": "^3.4.2",
		"@tiptap/pm": "^3.3.0",
		"@tiptap/react": "^3.3.0",
		"@tiptap/starter-kit": "^3.3.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"hast-util-from-html": "^2.0.3",
		"highlight.js": "^11.11.1",
		"keymatch": "^1.0.5",
		"lowlight": "^3.3.0",
		"mermaid": "^11.4.1",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"tailwind-merge": "^3.5.0",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.0.0",
		"yaml": "^2.9.0",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"react": "^19.1.0",
		"react-dom": "^19.1.0"
	},
	"devDependencies": {
		"@iconify-json/mingcute": "^1.2.7",
		"@tailwindcss/vite": "^4.1.18",
		"@types/hast": "^3.0.4",
		"@types/mdast": "^4.0.4",
		"@types/react": "^19.1.8",
		"@types/unist": "^3.0.3",
		"happy-dom": "^20.10.3",
		"tailwindcss": "^4.1.18",
		"typescript": "~5.8.3",
		"unplugin-icons": "^23.0.1",
		"vite": "^7.0.4",
		"vitest": "^3.2.4"
	}
}
