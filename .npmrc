# Private @tektrg/* packages (e.g. @tektrg/diagram-kit) live on GitHub Packages.
# Token comes from the environment only — never commit one:
#   export NODE_AUTH_TOKEN=$(gh auth token)   # account needs read:packages
@tektrg:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
