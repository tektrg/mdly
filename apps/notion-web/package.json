{
	"name": "@hubble.md/notion-web",
	"type": "module",
	"version": "0.0.1",
	"private": true,
	"description": "mdly — lightweight Notion browser/editor in the browser",
	"license": "MIT",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"typecheck": "tsc -b --noEmit",
		"worker:dev": "wrangler dev",
		"deploy": "pnpm build && wrangler deploy"
	},
	"dependencies": {
		"@hubble.md/editor": "workspace:*",
		"@hubble.md/ui": "workspace:*",
		"@tiptap/core": "^3.4.3",
		"@tiptap/pm": "^3.3.0",
		"@tiptap/react": "^3.3.0",
		"open-props": "^1.7.23",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20241127.0",
		"@iconify-json/mingcute": "^1.2.7",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^25.5.0",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^4.6.0",
		"tailwindcss": "^4.1.18",
		"typescript": "~5.8.3",
		"unplugin-icons": "^23.0.1",
		"vite": "^7.0.4",
		"wrangler": "^4.107.0"
	}
}
