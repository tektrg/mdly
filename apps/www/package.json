{
	"name": "@hubble.md/www",
	"type": "module",
	"version": "0.0.1",
	"private": true,
	"description": "Hubble.md in the browser",
	"license": "MIT",
	"author": "Ben Holmes <hey@bholmes.dev>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bholmesdev/hubble.md.git",
		"directory": "apps/www"
	},
	"homepage": "https://hubble.md",
	"bugs": "https://github.com/bholmesdev/hubble.md/issues",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"typecheck": "tsc -b --noEmit",
		"worker:dev": "wrangler dev",
		"test:worker": "vitest run",
		"test:web": "vitest run --config vitest.web.config.ts",
		"deploy": "pnpm build && wrangler deploy"
	},
	"dependencies": {
		"@hubble.md/sync": "workspace:*",
		"@hubble.md/ui": "workspace:*",
		"@mdly/cloudflare-client": "workspace:*",
		"@mdly/doc-comments": "workspace:*",
		"@mdly/doc-history": "workspace:*",
		"@mdly/workspace-kit": "workspace:*",
		"@simplestack/store": "^0.7.5",
		"@tiptap/core": "^3.4.3",
		"@tiptap/extension-image": "^3.20.0",
		"@tiptap/extension-list": "^3.4.2",
		"@tiptap/pm": "^3.3.0",
		"@tiptap/react": "^3.3.0",
		"@tiptap/starter-kit": "^3.3.0",
		"open-props": "^1.7.23",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-router": "^7.15.1",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"tw-animate-css": "^1.4.0",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.22.0",
		"@cloudflare/workers-types": "^5.20260815.1",
		"@iconify-json/mingcute": "^1.2.7",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^25.5.0",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^4.6.0",
		"happy-dom": "^20.10.3",
		"tailwindcss": "^4.1.18",
		"typescript": "~5.8.3",
		"unplugin-icons": "^23.0.1",
		"vite": "^7.0.4",
		"vitest": "^4.1.11",
		"wrangler": "^4.107.0"
	}
}
